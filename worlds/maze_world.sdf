<?xml version="1.0" ?>
<!--
  Procedural maze world  (seed=7, 10x8 cells, 20 x 16 m)
  Generated by generate_maze_world.py. Regenerate with: python3 generate_maze_world.py (seed option)
  Spawn : x=-4.0 y=3.3  (centre of a free cell)
  Loops : 7   Dead ends: 4   Crates: 6   Pillars: 3
  Goal pads (visual only):
    A: x=6.00 y=-4.70  (path length ~17 cells)
    B: x=-10.00 y=-6.70  (path length ~16 cells)
    C: x=8.00 y=7.30  (path length ~10 cells)
    D: x=-10.00 y=7.30  (path length ~9 cells)
-->
<sdf version="1.9">
  <world name="maze_world">

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
