<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>mobile_robot</name>
  <version>0.0.0</version>

  <description>
    ROS 2 mobile robot simulation using Gazebo Harmonic.
  </description>

  <maintainer email="karthii@todo.todo">karthii</maintainer>

  <license>TODO: License declaration</license>


  <!-- ========================================================= -->
  <!-- RUNTIME DEPENDENCIES                                      -->
  <!-- ========================================================= -->

  <!-- ROS 2 launch framework -->
  <exec_depend>launch</exec_depend>

  <!-- ROS 2 launch actions such as Node -->
  <exec_depend>launch_ros</exec_depend>

  <!-- ROS 2 Python API -->
  <exec_depend>rclpy</exec_depend>

  <!-- Process robot.xacro into URDF -->
  <exec_depend>xacro</exec_depend>

  <!-- Publishes TF from the robot description -->
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Publishes the Gazebo-scoped lidar TF bridge -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- Gazebo Harmonic integration -->
  <exec_depend>ros_gz_sim</exec_depend>

  <!-- ROS 2 <-> Gazebo communication -->
  <exec_depend>ros_gz_bridge</exec_depend>


  <!-- ========================================================= -->
  <!-- TEST DEPENDENCIES                                         -->
  <!-- ========================================================= -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>


  <!-- ========================================================= -->
  <!-- BUILD TYPE                                                -->
  <!-- ========================================================= -->

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>